{
  "info": {
    "name": "Basketwise CS3111",
    "description": "Run the Shopper workflow folder against the local app. Postman keeps session cookies. Collection pre-request scripts fetch CSRF tokens before writes. All monetary values are paise. Use the separate Admin folder only after setting private admin variables; no real credentials are embedded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:18080"
    },
    {
      "key": "shopperEmail",
      "value": ""
    },
    {
      "key": "shopperPassword",
      "value": "postman-demo-only-123"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (['POST','PUT','PATCH','DELETE'].includes(pm.request.method)) {",
          "  pm.sendRequest(pm.collectionVariables.get('baseUrl') + '/api/auth/csrf', (err, res) => {",
          "    if (err) throw err; const csrf = res.json(); pm.request.headers.upsert({key:csrf.headerName,value:csrf.token});",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Shopper workflow",
      "item": [
        {
          "name": "1 Register shopper",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Shopper\",\n  \"email\": \"{{shopperEmail}}\",\n  \"password\": \"{{shopperPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', () => pm.response.to.have.status(201));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('shopperEmail', 'postman-'+Date.now()+'@example.test');"
                ]
              }
            }
          ]
        },
        {
          "name": "2 Sign in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "email",
                  "value": "{{shopperEmail}}"
                },
                {
                  "key": "password",
                  "value": "{{shopperPassword}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expected status', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
